# Copy this file to the project root as server.env and edit it before deployment.
# Values use simple KEY=VALUE syntax.
TTLAB_SERVER_PORT=80
TTLAB_PUBLIC_BASE_URL=http://127.0.0.1
TTLAB_CLIENT_AUTH_ENABLED=0
TTLAB_CLIENT_TOKENS=
TTLAB_RELEASE_DIR=/srv/ttlab/releases

# Optional native TLS. Set both paths and TTLAB_TLS_REQUIRED=1 together.
TTLAB_TLS_REQUIRED=0
TTLAB_TLS_KEY_FILE=
TTLAB_TLS_CERT_FILE=
