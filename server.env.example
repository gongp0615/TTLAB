# TTLAB Server runtime configuration template.
# Copy this file to server.env (git-ignored, machine-local) and edit it:
#   cp server.env.example server.env
# The start/deploy scripts create server.env from this template automatically
# when it is missing.
TTLAB_SERVER_PORT=9000
TTLAB_PUBLIC_BASE_URL=http://127.0.0.1:9000
TTLAB_CLIENT_AUTH_ENABLED=0
TTLAB_CLIENT_TOKENS=
# Client 发布包与固件存储根目录。默认使用运行用户家目录下的
# ~/.local/state/ttlab-server/releases（无需 root；调试与部署各用户自行可写）。
# 如需指定绝对路径（例如系统级部署），可取消注释并填写：
# TTLAB_RELEASE_DIR=/path/to/releases
TTLAB_TLS_REQUIRED=0
TTLAB_TLS_KEY_FILE=
TTLAB_TLS_CERT_FILE=
# Structured file log store (device logs, events, commands, audit).
TTLAB_LOG_DIR=./data/logs
TTLAB_LOG_RETENTION_DAYS=30
TTLAB_LOG_FLUSH_MS=500
# Agent integration: enable the MCP endpoint and the Web chat panel.
# Agent/model settings below are editable at runtime from the Web console
# (系统设置 → Agent / 模型设置). Saving writes back to this file.
# WARNING: after saving API keys here, this file becomes machine-local and
# must NOT be committed to the repository.
TTLAB_AGENT_ENABLED=0
# server-native: built-in engine (direct LLM calls). dsh: delegate the whole
# agent (context, tool calls, approvals) to a DeepSeek Harness web service.
TTLAB_AGENT_ENGINE=server-native
TTLAB_AGENT_TOKEN=
TTLAB_AGENT_MODEL=deepseek-chat
TTLAB_DEEPSEEK_API_KEY=
TTLAB_AGENT_LLM_URL=https://api.deepseek.com
TTLAB_AGENT_MAX_SESSIONS=8
TTLAB_AGENT_APPROVAL_TIMEOUT_MS=60000
# dsh engine: local API of the `dsh web` service and the agent work directory.
TTLAB_DSH_BASE_URL=http://127.0.0.1:9333
TTLAB_DSH_WORKDIR=./data/agent-work
TTLAB_DSH_TOKEN=
